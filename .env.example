# DeployFix Lab — Master Environment Variables Specification
# Copy this file to .env for local development
# WARNING: Never commit .env containing real secrets to Git repositories

# Subsystem Execution Environment
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# Database Connection Configuration (PostgreSQL + Prisma)
# Local Dev (Docker Compose): postgresql://dfix:secret@postgres:5432/deployfix_db
# Cloud (Supabase PostgreSQL): postgresql://<user>:<password>@<supabase-host>:5432/<db_name>?sslmode=require
DATABASE_URL=postgresql://dfix:secret@localhost:5432/deployfix_db

# Authentication & Security
JWT_SECRET=deployfix_lab_dev_jwt_secret_change_in_production_32bytes
JWT_REFRESH_SECRET=deployfix_lab_dev_jwt_refresh_secret_change_in_production_32bytes

# Frontend Client Configuration (React + Vite)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# DeployFix AI Engine Configuration
# AI Provider selection: 'mock' (offline testing) | 'openai' (production GPT-4o)
AI_PROVIDER=mock
OPENAI_API_KEY=sk-placeholder-openai-api-key-for-local-development
OPENAI_MODEL=gpt-4o

# Docker & Infrastructure Integration
DOCKER_SOCKET_ENABLED=false
