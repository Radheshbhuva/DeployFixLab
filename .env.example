# ─────────────────────────────────────────────────────────────────
# DeployFix Lab — Unified Environment Configuration Template
# Copy this file to .env and configure for local or cloud deployment.
# NEVER commit your actual .env file to version control.
# ─────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────
# 1. APPLICATION ENVIRONMENT & NETWORKING
# ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Whitelisted origins for CORS (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost,https://deployfixlab.vercel.app

# ─────────────────────────────────────────────────────────────────
# 2. DATABASE CONFIGURATION (PostgreSQL / Supabase)
# ─────────────────────────────────────────────────────────────────
# LOCAL DOCKER COMPOSE:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deployfix_lab?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/deployfix_lab?schema=public

# CLOUD SUPABASE PRODUCTION (uncomment and replace when deploying to Cloud):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Docker PostgreSQL container settings (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=deployfix_lab

# ─────────────────────────────────────────────────────────────────
# 3. AUTHENTICATION & SECURITY SECRETS
# ─────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=deployfix_super_secure_jwt_secret_development_key_min_64chars_long
JWT_REFRESH_SECRET=deployfix_super_secure_jwt_refresh_secret_development_key_min_64chars_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────────
# 4. FRONTEND ENVIRONMENT CONFIGURATION (Vite Client)
# ─────────────────────────────────────────────────────────────────
# Local Docker or local dev:
VITE_API_URL=http://localhost:5000/api
VITE_WS_URL=ws://localhost:5000
VITE_ENVIRONMENT=development
VITE_ENABLE_AI_DIAGNOSIS=true
VITE_ENABLE_CHAOS_PANEL=true
VITE_APP_NAME=DeployFix Lab
VITE_APP_VERSION=1.0.0

# Cloud Production (Vercel):
# VITE_API_URL=https://deployfix-api.onrender.com/api
# VITE_WS_URL=wss://deployfix-api.onrender.com
# VITE_ENVIRONMENT=production

# Supabase Auth / Client keys (Optional if using backend-managed auth)
VITE_SUPABASE_URL=https://qedrwezcgjdxfyqqeyfm.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_q9dtY-BGtHHKE8qAgAM2mg_k54MTMcB

# ─────────────────────────────────────────────────────────────────
# 5. GITHUB APP INTEGRATION (Optional)
# ─────────────────────────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_SLUG=deployfix-lab
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_PAT=

# ─────────────────────────────────────────────────────────────────
# 6. AI PROVIDER CONFIGURATION (Optional)
# ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=

