# DeployFix Lab — Source Control Ignore Specification

# Environment Variables & Secrets (CRITICAL: Never commit secrets to Git)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
.env.file
!.env.example

# Dependency Directories
node_modules/
.pnpm-store/
.yarn/
jspm_packages/
web_modules/

# Build & Compilation Outputs
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo
*.tgz

# Testing & Coverage Reports
coverage/
.nyc_output/
junit.xml
test-results/

# Log Files & Runtime Debugging
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE & Editor Specific Configuration
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# OS System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary & Cache Directories
.cache/
.eslintcache
.stylelintcache
.prettiercache
.parcel-cache/
.vitest-cache/
*.tmp
*.bak
