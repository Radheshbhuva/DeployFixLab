# ─────────────────────────────────────────────────────────────────
# DeployFix Lab — Frontend Environment Variables Template
# All variables MUST start with VITE_ to be exposed to the client bundle.
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────
# API & WebSocket Endpoints
# ─────────────────────────────────────────────────────────────────
# Local Development:
VITE_API_URL=http://localhost:5000/api
VITE_WS_URL=ws://localhost:5000

# Production (Render backend):
# VITE_API_URL=https://deployfix-api.onrender.com/api
# VITE_WS_URL=wss://deployfix-api.onrender.com

# ─────────────────────────────────────────────────────────────────
# Supabase Configuration (Public / publishable — safe to expose)
# ─────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# ─────────────────────────────────────────────────────────────────
# Environment Label
# ─────────────────────────────────────────────────────────────────
VITE_ENV=development

# ─────────────────────────────────────────────────────────────────
# App Metadata
# ─────────────────────────────────────────────────────────────────
VITE_APP_NAME=DeployFix Lab
VITE_APP_VERSION=1.0.0

# ─────────────────────────────────────────────────────────────────
# Feature Flags
# ─────────────────────────────────────────────────────────────────
VITE_ENABLE_AI_DIAGNOSIS=true
VITE_ENABLE_CHAOS_PANEL=true
