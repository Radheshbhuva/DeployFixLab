{
  "name": "deployfix-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Evidence-Based Production Deployment Troubleshooting & Guided Recovery Platform",
  "author": "Radhesh Bhuva <@Radheshbhuva>",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "echo \"Starting DeployFix Lab development environment...\"",
    "build": "tsc --build",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "validate": "npm run lint && npm run format:check && npm run type-check && npm run test"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.3.2",
    "typescript": "~5.4.5",
    "vitest": "^1.6.0",
    "zod": "^3.23.8"
  }
}
